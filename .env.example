# Copy to .env and fill in real values. .env is gitignored - never commit it.

# ---------- Telegram ----------
# From @BotFather. Treat as a password.
TELEGRAM_BOT_TOKEN=123456789:AAExampleFakeTokenReplaceMeWithYourOwn

# Numeric Telegram user IDs with admin rights, comma separated.
# Get yours from @userinfobot. NEVER use @usernames as identity.
ADMIN_TELEGRAM_IDS=000000000

# ---------- ComfyUI (local, keep on loopback) ----------
COMFYUI_HOST=127.0.0.1
COMFYUI_PORT=8188
# Where ComfyUI itself writes results (read by this app, never written to).
COMFYUI_OUTPUT_DIR=D:\Comfy-Desktop\ComfyUI-Shared\output

# ---------- Local paths (relative to project root unless absolute) ----------
DATABASE_PATH=data/app.db
WORKFLOW_DIR=workflows
OUTPUT_DIR=outputs
LOG_DIR=logs

# ---------- Generation defaults ----------
DEFAULT_WORKFLOW=txt2img_h3_plate
DEFAULT_DAILY_QUOTA=10
JOB_TIMEOUT_SECONDS=1800

# ---------- Anthropic (NOT needed until v0.3) ----------
# ANTHROPIC_API_KEY=
